# ---------------------------------------------------------------------------
# Audit target configuration. Defaults here are the LIVE-SAFE ones.
# Override for local fixture runs via: AUDIT_ENV=fixture/fixture.env
# ---------------------------------------------------------------------------

# Scheme + host of the site under audit. No trailing slash.
TARGET_URL="http://localhost:8080"

# Host:port of the target. Must match TARGET_URL.
TARGET_HOST="localhost:8080"

# Additional hosts we are permitted to fetch from (CDN / asset origins),
# comma-separated. Anything not listed here or in TARGET_HOST is refused by
# bin/guard.sh. There is deliberately no "auto" mode: unbounded host spanning
# is how a site mirror turns into a crawl of the open web.
EXTRA_HOSTS="127.0.0.1:8081"

# Rules-of-engagement attestation. REQUIRED for any non-loopback target.
# bin/guard.sh hard-refuses to run without it. Set to one of:
#   "we own and operate this site"
#   "written authorization from <party>, dated <date>"
OWNERSHIP=""

# Truthful User-Agent. Lands permanently in the target's access logs, so the
# contact must be a monitored role address, never a personal one.
AUDIT_CONTACT="SET_ME_BEFORE_LIVE_RUN"
AUDIT_UA="Webbin-Audit/1.0 (internal security audit; contact ${AUDIT_CONTACT})"

# --- Politeness -------------------------------------------------------------
# Minimum milliseconds between HTTP requests. Applied globally in crawl.js
# (all requests, not just navigations) and converted to seconds for wget.
REQ_DELAY_MS=500

# Max simultaneous browser pages. wget is single-threaded regardless.
CONCURRENCY=2

# --- Budget guards ----------------------------------------------------------
# At REQ_DELAY_MS=500 the hard ceiling is ~2 req/s, so ~3600 requests per
# 30 minutes. These caps stop a run before it silently blows past that.
MAX_ROUTES=500
PHASE_TIMEOUT_SEC=1800
PAGE_TIMEOUT_MS=60000

# Full-page screenshots are 5-20x the bytes of viewport shots. Off by default;
# set to 1 when you specifically need above-the-fold-to-footer capture.
FULL_PAGE_SHOTS=0
