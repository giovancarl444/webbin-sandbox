# Negative-case fixture: a site with nothing to find. Proves the pipeline
# completes when every scanner comes back empty.
TARGET_URL="http://localhost:8082"
TARGET_HOST="localhost:8082"
EXTRA_HOSTS=""
OWNERSHIP="local fixture (loopback)"
AUDIT_CONTACT="fixture@localhost"
AUDIT_UA="Webbin-Audit/1.0 (internal security audit; bare fixture run)"
REQ_DELAY_MS=25
CONCURRENCY=2
MAX_ROUTES=100
PHASE_TIMEOUT_SEC=300
PAGE_TIMEOUT_MS=30000
FULL_PAGE_SHOTS=0
