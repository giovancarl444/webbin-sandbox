# Local fixture overrides. Loopback only -- no politeness budget needed, and
# guard.sh permits loopback targets without an OWNERSHIP attestation.
TARGET_URL="http://localhost:8080"
TARGET_HOST="localhost:8080"
EXTRA_HOSTS="127.0.0.1:8081"
OWNERSHIP="local fixture (loopback)"
AUDIT_CONTACT="fixture@localhost"
AUDIT_UA="Webbin-Audit/1.0 (internal security audit; fixture run)"
REQ_DELAY_MS=25
CONCURRENCY=2
MAX_ROUTES=500
PHASE_TIMEOUT_SEC=600
PAGE_TIMEOUT_MS=30000
FULL_PAGE_SHOTS=1
